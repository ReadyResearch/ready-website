---
import { profile, template } from '../../settings'
import SocialIcons from './SocialIcons.astro'

const { fullName } = profile
---
<aside
	class='px-4 pt-4 h-screen w-[20rem] bg-base-200 text-base-content flex flex-col'
>
	<div class='flex flex-col my-8 justify-between h-full'>
		<div>
			<div class='flex justify-center items-center flex-col'>
				<img src="/images/logo.png" alt="Ready Research" class="w-32" />
				<h1 class="text-lg font-black mt-4 hidden lg:block">{fullName}</h1>
			</div>
			<div class='mx-4 mt-16'>
				<ul class='space-y-4 menu grow shrink menu-md overflow-y-auto'>
					<li>
						<a href={`${template.base}/`} class='text-lg'>Home</a>
					</li>
					<li>
						<a href={`${template.base}/about`} class='text-lg'>About</a>
					</li>
					<li>
						<a href={`${template.base}/research`} class='text-lg'>Research</a>
					</li>
					<li>
						<a href={`${template.base}/resources`} class='text-lg'>Resources</a>
					</li>
					<li>
						<a href="https://forms.gle/ihLpTb432GmEstLM9" target="_blank" rel="noopener noreferrer" class='text-lg'>Contact Us</a>
					</li>
				</ul>
			</div>
		</div>
		<div class='mx-4'>
			<SocialIcons/>
		</div>
	</div>
</aside>
