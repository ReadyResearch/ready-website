---
import Layout from '@/layouts/Layout.astro'

const researchAreas = [
	{
		id: 'pandemic',
		title: 'Pandemic Management & Prevention',
		description: 'The Survey of Covid-19 Behaviours (SCRUB) project aimed to provide current and future policymakers with actionable insights into public attitudes and behaviours relating to the COVID-19 pandemic. It was led by Ready Research partnering with BehaviourWorks Australia, Monash Sustainable Development Institute, Monash University and Australian Catholic University, plus over 100 international researchers. In Australia, SCRUB received pilot funding from Monash Sustainable Development Institute, then Victorian Government funding for 15 months, producing 21 waves of data collection and reporting.',
		image: '/images/research-scrub.jpg',
		papers: [
			{
				title: 'Information safety assurances increase intentions to use COVID-19 contact tracing applications, regardless of autonomy-supportive or controlling message framing',
				url: 'https://www.frontiersin.org/articles/10.3389/fpsyg.2020.591638/full',
			},
			{
				title: 'Age and education moderate the relationship between confidence in health and political authorities and intention to adopt COVID-19 health-protective behaviours',
				url: 'https://osf.io/cwfx2/download?format=pdf',
			},
		],
	},
	{
		id: 'animal-welfare',
		title: 'Animal Welfare',
		description: 'We recently completed an overview of reviews identifying interventions that reduce dietary consumption of animal products.',
		papers: [
			{
				title: 'Interventions to reduce animal product consumption (ScienceDirect)',
				url: 'https://www.sciencedirect.com/science/article/pii/S2666833521000976',
			},
			{
				title: 'What interventions influence animal product consumption? (EA Forum)',
				url: 'https://forum.effectivealtruism.org/posts/azHZ2pQj9JgdZLC63/what-interventions-influence-animal-product-consumption',
			},
		],
	},
	{
		id: 'charitable-donations',
		title: 'Charitable Donations',
		description: 'We conducted an overview of systematic reviews identifying interventions that promote charitable donations.',
		papers: [
			{
				title: 'Interventions promoting charitable donations (Springer)',
				url: 'https://link.springer.com/article/10.1007/s11266-022-00499-y',
			},
			{
				title: 'Summary of charitable donations review',
				url: 'https://docs.google.com/document/d/1osAwuO1J9L2z3PDGQn6UkFEA-4vs5WV9eJ5hAASnS7o/edit?usp=sharing',
			},
		],
	},
]
---

<Layout title="Research | Ready Research">
	<div class="prose max-w-none">
		<h1 class="text-3xl font-bold mb-12">Research Outputs</h1>

		<div class="flex flex-col gap-12 not-prose">
			{researchAreas.map((area) => (
				<section id={area.id} class="p-6 rounded-lg bg-base-200">
					<h2 class="text-2xl font-bold mb-4">{area.title}</h2>
					{area.image && (
						<img src={area.image} alt={area.title} class="rounded-lg mb-4 max-h-64 object-cover w-full" />
					)}
					<p class="text-base mb-6">{area.description}</p>
					<h3 class="text-lg font-semibold mb-3">Published Papers</h3>
					<div class="flex flex-col gap-2">
						{area.papers.map((paper) => (
							<a href={paper.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-3 rounded bg-base-300 hover:bg-base-100 transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" class="w-5 h-5 shrink-0 stroke-current">
									<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
								</svg>
								<span>{paper.title}</span>
							</a>
						))}
					</div>
				</section>
			))}
		</div>
	</div>
</Layout>
