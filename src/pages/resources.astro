---
import Layout from '@/layouts/Layout.astro'

const resources = [
	{
		title: 'Excel AMSTAR 2 Checklist',
		description: 'The AMSTAR 2 checklist assesses quality and internal validity of review evidence. We use it extensively in our overview of reviews work. Alexander Saeri created a spreadsheet to simplify the completion process, which can be imported into Google Docs for collaborative editing.',
		url: 'https://drive.google.com/open?id=1w3ycm4LYlKjaR60bol7BU1KyY2wRSjlY',
		linkText: 'Get the Excel AMSTAR 2 checklist',
	},
	{
		title: 'How to use AI speech transcription and analysis to accelerate social science research',
		description: 'A guide on utilizing AI tools to accelerate social science research.',
		url: 'https://forum.effectivealtruism.org/posts/nxBKxFcfMnEb3Cmys/how-to-use-ai-speech-transcription-and-analysis-to',
		linkText: 'Read on EA Forum',
	},
	{
		title: 'Concrete actions to improve AI governance: the behaviour science approach',
		description: 'A summary explaining how behavioral science can enhance artificial intelligence governance.',
		url: 'https://forum.effectivealtruism.org/posts/LD6wKNdPbxfdgYnao/concrete-actions-to-improve-ai-governance-the-behaviour',
		linkText: 'Read on EA Forum',
	},
]
---

<Layout title="Resources | Ready Research">
	<div class="prose max-w-none">
		<h1 class="text-3xl font-bold mb-8">Resources</h1>
		<p class="text-lg mb-12">
			On this page we share some of our resources in the spirit of open and reproducible science.
		</p>

		<div class="flex flex-col gap-6 not-prose">
			{resources.map((resource) => (
				<div class="p-6 rounded-lg bg-base-200">
					<h2 class="text-xl font-bold mb-3">{resource.title}</h2>
					<p class="mb-4">{resource.description}</p>
					<a href={resource.url} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary text-secondary-content">
						{resource.linkText}
					</a>
				</div>
			))}
		</div>
	</div>
</Layout>
