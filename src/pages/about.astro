---
import Layout from '@/layouts/Layout.astro'

const team = [
	{
		name: 'Michael Noetel',
		role: 'Co-founder',
		image: '/images/team-michael.jpg',
		linkedin: 'https://www.linkedin.com/in/mnoetel/',
	},
	{
		name: 'Emily Grundy',
		role: 'Co-founder',
		image: '/images/team-emily.jpg',
		linkedin: 'https://www.linkedin.com/in/emily-grundy/',
	},
	{
		name: 'Peter Slattery',
		role: 'Co-founder',
		image: '/images/team-peter.jpg',
		linkedin: 'https://www.linkedin.com/in/peterslattery1/',
	},
	{
		name: 'Alexander Saeri',
		role: 'Co-founder',
		image: '/images/team-alexander.jpg',
		linkedin: 'https://www.linkedin.com/in/aksaeri/',
	},
]

const impacts = [
	'Published peer-reviewed meta-review on interventions reducing animal product consumption',
	'Published meta-review on charitable donation promotion interventions',
	'SCRUB project: 15-month government funding, 21 data collection waves',
	'Career advancement for collaborators including fellowships and staff hires at research organizations',
	'Newsletter exceeding 1,000 subscribers',
	'Facilitated employment opportunities for volunteers',
]
---

<Layout title="About | Ready Research">
	<div class="prose max-w-none">
		<h1 class="text-3xl font-bold mb-8">About Ready Research</h1>

		<!-- Founding Story -->
		<section class="mb-12">
			<h2 class="text-2xl font-bold mb-4">Our Story</h2>
			<p class="text-lg mb-4">
				From 2019 to 2026, we provided research, training, and communication services to help address the world's most pressing problems. Ready Research is now on indefinite pause. Michael Noetel, Alexander Saeri and Peter Slattery are academic researchers who met at a conference in 2017 and founded Ready Research in 2019. Emily Grundy joined Ready Research to lead the animal products review in 2019 and became part of the leadership team in 2020.
			</p>
			<div class="mt-6">
				<img src="/images/team-group.jpg" alt="Ready Research core team" class="rounded-lg w-full object-cover" />
			</div>
		</section>

		<!-- Leadership Team -->
		<section class="mb-12">
			<h2 class="text-2xl font-bold mb-6">Leadership Team</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 not-prose">
				{team.map((member) => (
					<div class="card bg-base-200">
						<figure class="px-4 pt-4">
							<img src={member.image} alt={member.name} class="rounded-xl w-full aspect-square object-cover" />
						</figure>
						<div class="card-body items-center text-center">
							<h3 class="card-title text-lg">{member.name}</h3>
							<p class="text-sm opacity-70">{member.role}</p>
							<a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline mt-2">
								LinkedIn
							</a>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- Volunteers -->
		<section class="mb-12">
			<h2 class="text-2xl font-bold mb-4">Our Volunteers</h2>
			<img src="/images/volunteers.jpg" alt="Ready Research volunteers and team" class="rounded-lg w-full object-cover mb-4" />
			<p class="text-lg">
				We have collaborated with more than 100 volunteers serving as advisors, team leaders, and team members. Over 100 additional researchers assisted with the SCRUB project.
			</p>
		</section>

		<!-- Impacts -->
		<section class="mb-12">
			<h2 class="text-2xl font-bold mb-6">Our Impact</h2>
			<div class="flex flex-col gap-3 not-prose">
				{impacts.map((impact) => (
					<div class="flex items-start gap-3 p-4 rounded-lg bg-base-200">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" class="w-6 h-6 shrink-0 stroke-success mt-0.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<p>{impact}</p>
					</div>
				))}
			</div>
		</section>
	</div>
</Layout>
